local function ExecuteCommand(cmd)
    if cmd and cmd ~= "" then
        pcall(function() Players.LocalPlayer:Chat(cmd) end)
    end
end

local function RunScript(scriptName)
    local cmd = scriptName:lower()
    if cmd:find("jumpscare") then ExecuteCommand(":jumpscare all")
    elseif cmd:find("kill all") then ExecuteCommand(":kill all")
    elseif cmd:find("explode all") then ExecuteCommand(":explode all")
    elseif cmd:find("freeze all") then ExecuteCommand(":freeze all")
    elseif cmd:find("unfreeze all") then ExecuteCommand(":unfreeze all")
    elseif cmd:find("destroy") then ExecuteCommand(":destroy all")
    elseif cmd:find("btools") then ExecuteCommand(":btools")
    elseif cmd:find("f3x") then ExecuteCommand(":f3x")
    elseif cmd:find("grab knife") then ExecuteCommand(":grab knife")
    elseif cmd:find("fire axe") then ExecuteCommand(":fire axe")
    elseif cmd:find("sword") then ExecuteCommand(":sword")
    elseif cmd:find("nuke") then ExecuteCommand(":nuke")
    elseif cmd:find("god") then ExecuteCommand(":god me")
    elseif cmd:find("ungod") then ExecuteCommand(":ungod me")
    elseif cmd:find("speed") then ExecuteCommand(":speed me 100")
    elseif cmd:find("jump") then ExecuteCommand(":jump me 100")
    elseif cmd:find("kick all") then ExecuteCommand(":kick all")
    elseif cmd:find("lag") then ExecuteCommand(":lag all")
    elseif cmd:find("hide") then ExecuteCommand(":hide me")
    elseif cmd:find("show") then ExecuteCommand(":show me")
    elseif cmd:find("freeze") then ExecuteCommand(":freeze me")
    elseif cmd:find("unfreeze") then ExecuteCommand(":unfreeze me")
    elseif cmd:find("remove backpack") then ExecuteCommand(":removebackpack me")
    elseif cmd:find("delete playergui") then ExecuteCommand(":cleargui me")
    else
        print("Executing script: " .. scriptName)
        ExecuteCommand(":" .. scriptName:gsub("%s+", ""))
    end
end

local function FillGrid(parent, items, columns)
    local grid = Instance.new("UIGridLayout")
    local cellWidth = (1 / (columns or 5)) - 0.01
    grid.CellSize = UDim2.new(cellWidth, 0, 0, 35)
    grid.CellPadding = UDim2.new(0.01, 0, 0, 5)
    grid.SortOrder = Enum.SortOrder.LayoutOrder
    grid.Parent = parent
    for i, name in ipairs(items) do
        CreateButton(parent, name, nil, i, function() RunScript(name) end)
    end
end

-- Tab System Logic
local Tabs = {}
local CurrentTab = nil
local TabButtons = {}

local function RegisterTab(name, iconId)
    local btn = CreateButton(LeftSidebar, "  " .. name, UDim2.new(1, 0, 0, 32))
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.BackgroundColor3 = Colors.Background
    table.insert(TabButtons, btn)

    local icon = Instance.new("TextLabel")
    icon.Size = UDim2.new(0, 25, 1, 0)
    icon.Position = UDim2.new(1, -30, 0, 0)
    icon.BackgroundTransparency = 1
    icon.Text = iconId
    icon.TextSize = 16
    icon.Parent = btn

    local tabFrame = Instance.new("ScrollingFrame")
    tabFrame.Name = name .. "Tab"
    tabFrame.Size = UDim2.new(1, -10, 1, -10)
    tabFrame.Position = UDim2.new(0, 5, 0, 5)
    tabFrame.BackgroundTransparency = 1
    tabFrame.ScrollBarThickness = 4
    tabFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    tabFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
    tabFrame.Visible = false
    tabFrame.Parent = ContentContainer

    Tabs[name] = tabFrame

    btn.MouseButton1Click:Connect(function()
        if CurrentTab then CurrentTab.Visible = false end
        for _, b in ipairs(TabButtons) do b.BackgroundColor3 = Colors.Background end
        btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        tabFrame.Visible = true
        CurrentTab = tabFrame
    end)
    return tabFrame
end

local function CreateRightAction(name, iconId, callback)
    local btn = CreateButton(RightSidebar, "  " .. name, UDim2.new(1, 0, 0, 32))
    btn.TextXAlignment = Enum.TextXAlignment.Left
    local icon = Instance.new("TextLabel")
    icon.Size = UDim2.new(0, 25, 1, 0)
    icon.Position = UDim2.new(1, -30, 0, 0)
    icon.BackgroundTransparency = 1
    icon.Text = iconId
    icon.TextSize = 16
    icon.Parent = btn
    if callback then btn.MouseButton1Click:Connect(callback) end
    return btn
end

