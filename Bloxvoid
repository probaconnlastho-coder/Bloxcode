-- ---------- Detectors ----------
local function hasF3XTool()
    local lp = Players.LocalPlayer
    if not lp then return false end
    local function scan(container)
        if not container then return false end
        for _, v in ipairs(container:GetChildren()) do
            if v:IsA("Tool") then
                local n = v.Name:lower()
                if n:find("f3x") or n:find("fork3v") or n:find("building")
                    or v:FindFirstChild("SyncAPI") then
                    return true
                end
            end
        end
        return false
    end
    return scan(lp.Character) or scan(lp:FindFirstChildOfClass("Backpack")) or scan(lp)
end

local function hasHDRank()
    local lp = Players.LocalPlayer
    if not lp then return false end

    if not workspace:FindFirstChild("HDAdminWorkspaceFolder") then return false end

    local ok, isAdmin = pcall(function()
        local client = game:GetService("ReplicatedStorage"):FindFirstChild("HDAdminHDClient")
        if not client then return false end
        local modules = client:FindFirstChild("Modules")
        if not modules then return false end
        for _, m in ipairs(modules:GetChildren()) do
            if m:IsA("ModuleScript")
                and (m.Name:lower():find("permission") or m.Name:lower():find("rank")) then
                local mod = require(m)
                if type(mod) == "table" and mod.GetRank then
                    return mod.GetRank(lp) and true or false
                end
            end
        end
        return false
    end)
    if ok and isAdmin then return true end

    local ls = lp:FindFirstChild("leaderstats")
    if ls then
        for _, v in ipairs(ls:GetChildren()) do
            if v.Name:lower():find("rank") or v.Name:lower():find("admin") then
                local val = tostring(v.Value):lower()
                if val:find("admin") or val:find("owner") or val:find("mod")
                    or val:find("hd") or val:find("staff") then
                    return true
                end
            end
        end
    end
    return false
end

