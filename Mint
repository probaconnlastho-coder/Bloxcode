local function addRipple(btn, color)
	btn.ClipsDescendants = true
	btn.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local rel = Vector2.new(
			input.Position.X - btn.AbsolutePosition.X,
			input.Position.Y - btn.AbsolutePosition.Y
		)
		local r = new("Frame", {
			Parent = btn,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(rel.X, rel.Y),
			Size = UDim2.fromOffset(0, 0),
			BackgroundColor3 = color or Color3.new(1, 1, 1),
			BackgroundTransparency = 0.72,
			BorderSizePixel = 0,
			ZIndex = (btn.ZIndex or 1) + 2,
		})
		round(r, UDim.new(1, 0))
		local maxSize = math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y) * 2.4
		tween(r, 0.55, {
			Size = UDim2.fromOffset(maxSize, maxSize),
			BackgroundTransparency = 1,
		}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
		task.delay(0.6, function()
			if r and r.Parent then r:Destroy() end
		end)
	end)
end

local function addPress(btn, base)
	local sc = addScale(btn)
	base = base or 0.95
	btn.MouseEnter:Connect(function() tween(sc, 0.18, { Scale = 1.06 }) end)
	btn.MouseLeave:Connect(function() tween(sc, 0.18, { Scale = 1 }) end)
	btn.MouseButton1Down:Connect(function() tween(sc, 0.08, { Scale = base }) end)
	btn.MouseButton1Up:Connect(function() tween(sc, 0.25, { Scale = 1.06 }, Enum.EasingStyle.Back) end)
	return sc
end

--// Parent resolution (executor-agnostic) ----------------------
local function resolveParent(explicit)
	if explicit then return explicit, "explicit" end

	-- Priority 1: gethui / get_hidden_gui
	if getHiddenUI then
		local ok, hui = pcall(getHiddenUI)
		if ok and typeof(hui) == "Instance" then
			return hui, "gethui"
		end
	end

	-- Priority 2: CoreGui (with protection if available)
	local okCG, coreGui = pcall(function() return game:GetService("CoreGui") end)
	if okCG and coreGui then
		if protectGUI then
			return coreGui, "CoreGui (protected)"
		end
		local writable = pcall(function()
			local probe = Instance.new("Folder")
			probe.Parent = coreGui
			probe:Destroy()
		end)
		if writable then return coreGui, "CoreGui" end
	end

	-- Priority 3: PlayerGui (always works)
	local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not pg then pg = LocalPlayer:WaitForChild("PlayerGui", 10) end
	if pg then return pg, "PlayerGui" end

	error("[Auren] No valid parent found")
end

