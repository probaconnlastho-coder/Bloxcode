	--// Search handler
	local searchDebounce = false
	local function performSearch()
		if searchDebounce then return end
		searchDebounce = true
		task.delay(0.5, function() searchDebounce = false end)

		for _, child in ipairs(scriptListFrame:GetChildren()) do
			if child:IsA("Frame") then child:Destroy() end
		end

		local query = hubSearchInput.Text
		local activeFilters = {}
		if hubFilters.key ~= nil then activeFilters.key = hubFilters.key end
		if hubFilters.universal ~= nil then activeFilters.universal = hubFilters.universal end
		if hubFilters.verified ~= nil then activeFilters.verified = hubFilters.verified end

		if query == "" and next(activeFilters) == nil then
			hubStatusLbl.Text = "Type a search or tap a filter to begin."
			return
		end

		hubStatusLbl.Text = "Searching…"

		local scripts = fetchScriptBlox(query, activeFilters)
		if #scripts == 0 then
			hubStatusLbl.Text = "No scripts found. Try a different search."
			return
		end

		hubStatusLbl.Text = "Found " .. tostring(#scripts) .. " scripts"

		for _, scriptData in ipairs(scripts) do
			createScriptEntry(scriptData)
		end
	end

	hubSearchInput.FocusLost:Connect(function(enter)
		if enter then performSearch() end
	end)
	hubSearchInput:GetPropertyChangedSignal("Text"):Connect(function()
		task.delay(0.8, function()
			if hubSearchInput.Text ~= "" then performSearch() end
		end)
	end)

	for _, fb in ipairs(hubFilterButtons) do
		fb.btn.MouseButton1Click:Connect(function()
			task.delay(0.1, performSearch)
		end)
	end

