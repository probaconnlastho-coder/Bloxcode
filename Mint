function Library:CreateWindow(cfg)
	cfg = cfg or {}
	local Title     = cfg.Title or "Auren"
	local Subtitle  = cfg.Subtitle or "v2.3"
	local Size      = cfg.Size or Vector2.new(620, 440)

	local parent, parentName = resolveParent(cfg.Parent)
	print("[Auren] Parent:", parentName)

	local screen = Instance.new("ScreenGui")
	screen.Name = "AurenUI_" .. tostring(math.random(10000, 99999))
	screen.ResetOnSpawn = false
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screen.IgnoreGuiInset = true
	screen.DisplayOrder = 999999
	screen.Enabled = true
	screen.Parent = parent

	-- Apply protection if available
	if protectGUI then
		local ok, err = pcall(protectGUI, screen)
		if ok then
			print("[Auren] GUI protected via syn.protect_gui")
		else
			warn("[Auren] protect_gui failed:", err)
		end
	end

	--// WINDOW TABLE
	local Window = {
		ScreenGui = screen,
		Tabs = {},
		Pages = {},
		CurrentTab = 0,
		Size = Size,
		Accent = Theme.Accent,
		AccentAlt = Theme.AccentAlt,
		_dragEnabled = true,
		_bindings = {},
		_tabIndex = {},
		SavedScripts = {},
	}

	function Window:BindAccent(inst, prop, isAlt, kind)
		table.insert(self._bindings, {
			Inst = inst, Prop = prop, Alt = isAlt, Kind = kind or "Color"
		})
	end

	function Window:SetAccent(accent, accentAlt)
		self.Accent = accent
		self.AccentAlt = accentAlt
		Theme.Accent = accent
		Theme.AccentAlt = accentAlt
		for _, b in ipairs(self._bindings) do
			local col = b.Alt and accentAlt or accent
			if b.Kind == "Color" then
				b.Inst[b.Prop] = col
			elseif b.Kind == "Gradient" then
				b.Inst.Color = ColorSequence.new(accent, accentAlt)
			end
		end
