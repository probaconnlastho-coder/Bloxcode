				Window:BindAccent(fill, "BackgroundColor3", false)
				Window:BindAccent(fillGrad, nil, false, "Gradient")

				local knob = new("Frame", {
					Parent = track,
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.new(0, 0, 0.5, 0),
					Size = UDim2.fromOffset(14, 14),
					BackgroundColor3 = Color3.new(1, 1, 1),
					BorderSizePixel = 0, ZIndex = 11,
				})
				round(knob, UDim.new(1, 0))
				stroke(knob, Color3.new(0, 0, 0), 1, 0.85)

				local hitbox = new("TextButton", {
					Parent = row,
					Position = UDim2.fromOffset(14, 22),
					Size = UDim2.new(1, -28, 0, 30),
					BackgroundTransparency = 1, Text = "",
					AutoButtonColor = false, ZIndex = 12,
				})

				local state = { Value = default, Min = min, Max = max }
				local draggingSlider = false

				local function apply(value, fire)
					value = math.clamp(value, min, max)
					local alpha = (max - min > 0) and ((value - min) / (max - min)) or 0
					state.Value = value
					fill.Size = UDim2.fromScale(alpha, 1)
					knob.Position = UDim2.new(alpha, 0, 0.5, 0)
					if intMode then
						valueLbl.Text = tostring(math.floor(value + 0.5))
					else
						valueLbl.Text = string.format("%.2f", value)
					end
					if fire and callback then task.spawn(callback, value) end
				end

				local function fromInput(input)
					local rel = (input.Position.X - track.AbsolutePosition.X)
						/ math.max(track.AbsoluteSize.X, 1)
					apply(min + (max - min) * math.clamp(rel, 0, 1), true)
				end

				hitbox.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1
						or input.UserInputType == Enum.UserInputType.Touch then
						draggingSlider = true
						fromInput(input)
						tween(knob, 0.15, { Size = UDim2.fromOffset(18, 18) }, Enum.EasingStyle.Back)
					end
				end)
				UserInputService.InputChanged:Connect(function(input)
					if not draggingSlider then return end
					if input.UserInputType == Enum.UserInputType.MouseMovement
						or input.UserInputType == Enum.UserInputType.Touch then
						fromInput(input)
					end
				end)
				UserInputService.InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1
						or input.UserInputType == Enum.UserInputType.Touch then
						if draggingSlider then
							draggingSlider = false
							tween(knob, 0.25, { Size = UDim2.fromOffset(14, 14) }, Enum.EasingStyle.Back)
						end
					end
				end)

				function state:Set(v, silent) apply(v, not silent) end
				function state:Get() return state.Value end
				apply(default, false)
				return state
			end

