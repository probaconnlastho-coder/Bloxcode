local function cleanupOld()
	local targets = {}
	local ok1, cg = pcall(function() return game:GetService("CoreGui") end)
	if ok1 and cg then table.insert(targets, cg) end
	local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if pg then table.insert(targets, pg) end
	for _, parent in ipairs(targets) do
		for _, gui in ipairs(parent:GetChildren()) do
			if gui:IsA("ScreenGui") and string.find(gui.Name, "^AurenUI_") then
				pcall(function() gui:Destroy() end)
			end
		end
	end
end
