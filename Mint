		local function selectTab()
			if Window.CurrentTab == index then return end
			local oldIndex = Window.CurrentTab
			Window.CurrentTab = index

			if oldIndex > 0 and Window.Pages[oldIndex] then
				Window.Pages[oldIndex].Visible = false
				local old = Window.Tabs[oldIndex]
				if old then
					tween(old.TextLabel, 0.2, { TextColor3 = Theme.SubText })
					tween(old.Glyph, 0.2, { TextColor3 = Theme.SubText })
				end
			end

			for i, t in ipairs(Window.Tabs) do
				if i ~= index then
					tween(t.Button, 0.15, { BackgroundTransparency = 1 })
				end
			end

			page.Visible = true
			tween(textLbl, 0.2, { TextColor3 = Theme.Text })
			tween(glyphLbl, 0.2, { TextColor3 = Color3.new(1, 1, 1) })

			tween(indicator, 0.36, {
				Position = UDim2.fromOffset(8, TAB_TOP + (index - 1) * (TAB_H + TAB_GAP)),
			}, Enum.EasingStyle.Back)

			refreshIndicator()
		end

		btn.MouseEnter:Connect(function()
			tween(btn, 0.15, { BackgroundTransparency = 0.72 })
		end)
		btn.MouseLeave:Connect(function()
			tween(btn, 0.15, { BackgroundTransparency = 1 })
		end)
		btn.MouseButton1Click:Connect(selectTab)

		table.insert(Window.Tabs, { TextLabel = textLbl, Glyph = glyphLbl, Button = btn })
		Window.Pages[index] = page
		table.insert(Window._tabIndex, { Name = name, Button = btn, TabIndex = index })

		if index == 1 then
			Window.CurrentTab = 0
			selectTab()
		end
		return tab
	end

