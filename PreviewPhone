--//  HELPERS
--// ══════════════════════════════════════════════════════════
local function new(class, props)
	local inst = Instance.new(class)
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then parent = v else inst[k] = v end
	end
	if parent then inst.Parent = parent end
	return inst
end

local function round(inst, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = typeof(radius) == "UDim" and radius or UDim.new(0, radius)
	c.Parent = inst
	return c
end

local function stroke(inst, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color or Color3.new(1, 1, 1)
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0.85
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = inst
	return s
end

local function gradient(inst, c1, c2, rotation)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(c1, c2)
	g.Rotation = rotation or 0
	g.Parent = inst
	return g
end

local function tween(inst, time, props, style, dir)
	local t = TweenService:Create(
		inst,
		TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
		props
	)
	t:Play()
	return t
end

local function padding(inst, t, r, b, l)
	local p = Instance.new("UIPadding")
	p.PaddingTop, p.PaddingRight = UDim.new(0, t or 0), UDim.new(0, r or 0)
	p.PaddingBottom, p.PaddingLeft = UDim.new(0, b or 0), UDim.new(0, l or 0)
	p.Parent = inst
	return p
end

local function addScale(inst)
	local s = Instance.new("UIScale")
	s.Scale = 1
	s.Parent = inst
	return s
end

local function addRipple(btn, color)
	btn.ClipsDescendants = true
	btn.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local rel = Vector2.new(
			input.Position.X - btn.AbsolutePosition.X,
			input.Position.Y - btn.AbsolutePosition.Y
		)
		local r = new("Frame", {
			Parent = btn,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(rel.X, rel.Y),
			Size = UDim2.fromOffset(0, 0),
			BackgroundColor3 = color or Color3.new(1, 1, 1),
			BackgroundTransparency = 0.72,
			BorderSizePixel = 0,
			ZIndex = (btn.ZIndex or 1) + 2,
		})
		round(r, UDim.new(1, 0))
		local maxSize = math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y) * 2.4
		tween(r, 0.55, {
			Size = UDim2.fromOffset(maxSize, maxSize),
			BackgroundTransparency = 1,
		}, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
		task.delay(0.6, function()
			if r and r.Parent then r:Destroy() end
		end)
	end)
end

local function addPress(btn, base)
	local sc = addScale(btn)
	base = base or 0.95
	btn.MouseEnter:Connect(function() tween(sc, 0.18, { Scale = 1.06 }) end)
	btn.MouseLeave:Connect(function() tween(sc, 0.18, { Scale = 1 }) end)
	btn.MouseButton1Down:Connect(function() tween(sc, 0.08, { Scale = base }) end)
	btn.MouseButton1Up:Connect(function() tween(sc, 0.25, { Scale = 1.06 }, Enum.EasingStyle.Back) end)
	return sc
end

