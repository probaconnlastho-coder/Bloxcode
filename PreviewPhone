						LayoutOrder = i, ZIndex = 10,
					})
					round(item, 8)
					new("TextLabel", {
						Parent = item,
						Position = UDim2.fromOffset(12, 0),
						Size = UDim2.new(1, -36, 1, 0),
						BackgroundTransparency = 1, Text = tostring(opt),
						Font = Theme.Font, TextSize = 12,
						TextColor3 = Theme.Text,
						TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 11,
					})
					local check = new("Frame", {
						Parent = item,
						AnchorPoint = Vector2.new(1, 0.5),
						Position = UDim2.new(1, -12, 0.5, 0),
						Size = UDim2.fromOffset(6, 6),
						BackgroundColor3 = Theme.Accent,
						BorderSizePixel = 0, ZIndex = 11,
						Visible = (opt == selected),
					})
					round(check, UDim.new(1, 0))
					bindAccent(check, "BackgroundColor3", false)
					checks[opt] = check
					item.MouseEnter:Connect(function()
						tween(item, 0.15, { BackgroundTransparency = 0.25 })
					end)
					item.MouseLeave:Connect(function()
						tween(item, 0.15, { BackgroundTransparency = 0.55 })
					end)
					item.MouseButton1Click:Connect(function()
						selected = opt
						valueLbl.Text = tostring(opt)
						for k, c in pairs(checks) do c.Visible = (k == opt) end
						closeList()
						if callback then task.spawn(callback, opt) end
					end)
				end

				head.MouseButton1Click:Connect(function()
					if open then closeList() else openList() end
				end)

				local state = {}
				function state:Get() return selected end
				function state:Set(v)
					if checks[v] then
						selected = v
						valueLbl.Text = tostring(v)
						for k, c in pairs(checks) do c.Visible = (k == v) end
					end
				end
				state.Options = options
				return state
			end

			function section:AddTextbox(text, placeholder, callback)
				local row = self:_row(46)
				new("TextLabel", {
					Parent = row,
					Position = UDim2.fromOffset(14, 0),
					Size = UDim2.new(0.5, -14, 1, 0),
					BackgroundTransparency = 1, Text = text,
					Font = Theme.Font, TextSize = 13,
					TextColor3 = Theme.Text,
					TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 9,
				})
				local boxHolder = new("Frame", {
					Parent = row,
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -14, 0.5, 0),
					Size = UDim2.new(0, 170, 0, 30),
					BackgroundColor3 = Theme.SurfaceAlt,
					BackgroundTransparency = 0.35,
					BorderSizePixel = 0, ZIndex = 9,
				})
				round(boxHolder, 8)
				local boxStroke = stroke(boxHolder, Color3.fromRGB(60, 60, 64), 1, 0.5)
				local box = new("TextBox", {
					Parent = boxHolder,
					Position = UDim2.fromOffset(10, 0),
					Size = UDim2.new(1, -20, 1, 0),
					BackgroundTransparency = 1, Text = "",
					PlaceholderText = placeholder or "Enter…",
					PlaceholderColor3 = Theme.SubText,
					Font = Theme.Font, TextSize = 12,
					TextColor3 = Theme.Text,
					TextXAlignment = Enum.TextXAlignment.Left,
					ClearTextOnFocus = false, ZIndex = 10,
				})
				box.Focused:Connect(function()
					tween(boxStroke, 0.2, { Transparency = 0.2, Color = Theme.Accent })
					tween(boxHolder, 0.2, { BackgroundTransparency = 0.15 })
				end)
				box.FocusLost:Connect(function(enter)
					tween(boxStroke, 0.2, { Transparency = 0.5, Color = Color3.fromRGB(60, 60, 64) })
					tween(boxHolder, 0.2, { BackgroundTransparency = 0.35 })
					if enter and callback then task.spawn(callback, box.Text) end
				end)
				local state = {}
				function state:Get() return box.Text end
				function state:Set(v) box.Text = tostring(v) end
				return state
			end

			return section
		end

		--// TAB SELECTION
		local function selectTab()
			if Window.CurrentTab == index then return end
			local oldIndex = Window.CurrentTab
			Window.CurrentTab = index

			if oldIndex > 0 and Window.Pages[oldIndex] then
				Window.Pages[oldIndex].Visible = false
				local old = Window.Tabs[oldIndex]
				if old then
					tween(old.TextLabel, 0.2, { TextColor3 = Theme.SubText })
					tween(old.Glyph, 0.2, { TextColor3 = Theme.SubText })
				end
			end

			page.Visible = true
			tween(textLbl, 0.2, { TextColor3 = Theme.Text })
			tween(glyphLbl, 0.2, { TextColor3 = Color3.new(1, 1, 1) })

			tween(indicator, 0.36, {
				Position = UDim2.fromOffset(8, TAB_TOP + (index - 1) * (TAB_H + TAB_GAP)),
			}, Enum.EasingStyle.Back)
		end

		btn.MouseEnter:Connect(function()
			if Window.CurrentTab ~= index then
				tween(btn, 0.15, { BackgroundTransparency = 0.9 })
			end
		end)
		btn.MouseLeave:Connect(function()
			if Window.CurrentTab ~= index then
				tween(btn, 0.15, { BackgroundTransparency = 1 })
			end
		end)
		btn.MouseButton1Click:Connect(selectTab)

		table.insert(Window.Tabs, { TextLabel = textLbl, Glyph = glyphLbl, Button = btn })
		Window.Pages[index] = page
		table.insert(Window._tabIndex, { Name = name, Button = btn, TabIndex = index })

		if index == 1 then
			Window.CurrentTab = 0
			selectTab()
		end
		return tab
	end

	--// SEARCH FILTER -----------------------------------------
	searchInput:GetPropertyChangedSignal("Text"):Connect(function()
		local q = string.lower(searchInput.Text)
		local firstVisible
		for _, entry in ipairs(Window._tabIndex) do
			local matches = (q == "") or string.find(string.lower(entry.Name), q, 1, true) ~= nil
			entry.Button.Visible = matches
			if matches and not firstVisible then firstVisible = entry end
		end
		-- keep current tab visible-selection consistent
		if q ~= "" and firstVisible then
			local cur = Window._tabIndex[Window.CurrentTab]
			if cur and not cur.Button.Visible then
				-- don't auto-jump; just hide indicator
				tween(indicator, 0.2, { BackgroundTransparency = 1 })
			end
		else
			tween(indicator, 0.2, { BackgroundTransparency = 0.85 })
		end
	end)

	--// NOTIFICATIONS -----------------------------------------
	local toastHolder = new("Frame", {
		Parent = screen,
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -20, 1, -20),
		Size = UDim2.fromOffset(340, 500),
		BackgroundTransparency = 1, ZIndex = 200,
	})
	new("UIListLayout", {
		Parent = toastHolder, Padding = UDim.new(0, 12),
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})

	local toastOrder = 0

	local function makeNotifIcon(parent, kind)
		local color = Theme.Accent
		local label = "i"
		if kind == "success" then color = Theme.Green; label = "v"
		elseif kind == "warning" then color = Theme.Yellow; label = "!"
		elseif kind == "error" then color = Theme.Red; label = "x"
		end
		local circle = new("Frame", {
			Parent = parent,
			Position = UDim2.fromOffset(14, 14),
			Size = UDim2.fromOffset(36, 36),
			BackgroundColor3 = color,
			BorderSizePixel = 0, ZIndex = 202,
		})
		round(circle, UDim.new(1, 0))
		-- subtle inner gradient
		local g = Instance.new("UIGradient")
		g.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.new(0.7, 0.7, 0.7))
		g.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.75),
			NumberSequenceKeypoint.new(1, 1),
		})
		g.Rotation = 45
		g.Parent = circle

		if kind == "success" then
			-- draw checkmark
			local l1 = new("Frame", {
				Parent = circle,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.38, 0.55),
				Size = UDim2.fromOffset(7, 2),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0, Rotation = 45, ZIndex = 203,
			})
			round(l1, 1)
			local l2 = new("Frame", {
				Parent = circle,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.62, 0.45),
				Size = UDim2.fromOffset(12, 2),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0, Rotation = -45, ZIndex = 203,
			})
			round(l2, 1)
		elseif kind == "error" then
			-- draw X
			for _, rot in ipairs({ 45, -45 }) do
				local bar = new("Frame", {
					Parent = circle,
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromScale(0.5, 0.5),
					Size = UDim2.fromOffset(14, 2),
					BackgroundColor3 = Color3.new(1, 1, 1),
					BorderSizePixel = 0, Rotation = rot, ZIndex = 203,
				})
				round(bar, 1)
			end
		else
			new("TextLabel", {
				Parent = circle, Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1, Text = label,
				Font = Theme.FontBold, TextSize = 16,
				TextColor3 = Color3.new(1, 1, 1), ZIndex = 203,
			})
		end
	end

	function Window:Notify(title, message, duration, kind)
		toastOrder = toastOrder + 1
		duration = duration or 4
		kind = kind or "info"

		local toast = new("Frame", {
			Parent = toastHolder,
			Size = UDim2.fromOffset(340, 84),
			Position = UDim2.fromOffset(60, 0),
			BackgroundColor3 = Theme.Surface,
			BackgroundTransparency = 0.05,
			BorderSizePixel = 0,
			LayoutOrder = toastOrder, ZIndex = 201,
			ClipsDescendants = true,
		})
		round(toast, 14)
		stroke(toast, Color3.fromRGB(60, 60, 64), 1, 0.55)

		makeNotifIcon(toast, kind)

		new("TextLabel", {
			Parent = toast,
			Position = UDim2.fromOffset(62, 14),
			Size = UDim2.new(1, -76, 0, 18),
			BackgroundTransparency = 1, Text = title,
			Font = Theme.FontBold, TextSize = 14,
			TextColor3 = Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 202,
		})
		new("TextLabel", {
			Parent = toast,
			Position = UDim2.fromOffset(62, 32),
			Size = UDim2.new(1, -76, 0, 40),
			BackgroundTransparency = 1, Text = message or "",
			Font = Theme.Font, TextSize = 11,
			TextColor3 = Theme.SubText,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextWrapped = true, ZIndex = 202,
		})

		-- progress bar
		local barBg = new("Frame", {
			Parent = toast,
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 0, 1, 0),
			Size = UDim2.new(1, 0, 0, 3),
			BackgroundColor3 = Color3.fromRGB(40, 40, 44),
			BorderSizePixel = 0, ZIndex = 202,
		})
		local bar = new("Frame", {
			Parent = barBg,
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundColor3 = (kind == "success" and Theme.Green)
				or (kind == "warning" and Theme.Yellow)
				or (kind == "error" and Theme.Red)
				or Theme.Accent,
			BorderSizePixel = 0, ZIndex = 203,
		})

		-- entrance: spring slide from right
		tween(toast, 0.5, {
			Position = UDim2.fromOffset(0, 0),
		}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		tween(toast, 0.35, { BackgroundTransparency = 0.02 })

		tween(bar, duration, {
			Size = UDim2.new(0, 0, 1, 0),
		}, Enum.EasingStyle.Linear)

		-- exit
		task.delay(duration, function()
			tween(toast, 0.4, {
				Position = UDim2.fromOffset(80, 0),
				BackgroundTransparency = 1,
			}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
			task.delay(0.45, function()
				if toast and toast.Parent then toast:Destroy() end
			end)
		end)
	end

	--// FLOATING BUTTON (top center, movable) -----------------
	local floating = new("TextButton", {
		Parent = screen,
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.new(0.5, -26, 0, 18),
		Size = UDim2.fromOffset(52, 52),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0, Text = "A",
		Font = Theme.FontBold, TextSize = 20,
		TextColor3 = Color3.new(1, 1, 1),
		AutoButtonColor = false, Visible = false,
		ZIndex = 300,
	})
	round(floating, 16)
	local floatGrad = gradient(floating, Theme.Accent, Theme.AccentAlt, 45)
	stroke(floating, Color3.new(1, 1, 1), 1, 0.75)
	bindAccent(floating, "BackgroundColor3", false)
	bindAccent(floatGrad, nil, false, "Gradient")

	local floatScale = addScale(floating)

	-- floating drag
	local fDrag = { active = false, moved = false, startMouse = nil, startPos = nil }

	floating.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		fDrag.active = true
		fDrag.moved = false
		fDrag.startMouse = UserInputService:GetMouseLocation()
		fDrag.startPos = Vector2.new(
			floating.AbsolutePosition.X, floating.AbsolutePosition.Y
		)
		tween(floatScale, 0.15, { Scale = 0.92 })
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not fDrag.active then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local delta = UserInputService:GetMouseLocation() - fDrag.startMouse
		if delta.Magnitude > 4 then fDrag.moved = true end
		if fDrag.moved then
			floating.Position = UDim2.fromOffset(
				fDrag.startPos.X + delta.X,
				fDrag.startPos.Y + delta.Y
			)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		if fDrag.active and not fDrag.moved then
			Window:Open()
		end
		fDrag.active = false
		tween(floatScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	end)

	--// OPEN / MINIMIZE / CLOSE -------------------------------
	local busy = false

	function Window:Minimize()
		if busy then return end
		busy = true

		-- fade + shrink
		fader.BackgroundTransparency = 1
		tween(fader, 0.28, { BackgroundTransparency = 0.02 })
		tween(rootScale, 0.3, { Scale = 0.85 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)

		task.delay(0.32, function()
			root.Visible = false
			rootScale.Scale = 1
			fader.BackgroundTransparency = 1

			-- show floating button with a spring
			floating.Visible = true
			floating.Size = UDim2.fromOffset(10, 10)
			tween(floating, 0.45, {
				Size = UDim2.fromOffset(52, 52),
			}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

			busy = false
		end)
	end

	function Window:Open()
		if busy then return end
		busy = true

		-- hide floating button with shrink
		tween(floating, 0.28, {
			Size = UDim2.fromOffset(10, 10),
		}, Enum.EasingStyle.Quart, Enum.EasingDirection.In)

		task.delay(0.3, function()
			floating.Visible = false

			root.Visible = true
			rootScale.Scale = 0.85
			fader.BackgroundTransparency = 0.02

			tween(rootScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			tween(fader, 0.4, { BackgroundTransparency = 1 })

			busy = false
		end)
	end

	function Window:Destroy()
		if busy then return end
		busy = true
		fader.BackgroundTransparency = 1
		tween(fader, 0.28, { BackgroundTransparency = 0.02 })
		tween(rootScale, 0.3, { Scale = 0.85 }, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
		task.delay(0.32, function()
			if screen and screen.Parent then screen:Destroy() end
			busy = false
		end)
	end

	minBtn.MouseButton1Click:Connect(function() Window:Minimize() end)
	closeBtn.MouseButton1Click:Connect(function() Window:Destroy() end)

	-- safety re-parent
	task.delay(2, function()
		if screen and not screen.Parent then
			screen.Parent = LocalPlayer:WaitForChild("PlayerGui")
		end
	end)

	print("[Auren] Window ready. Parent =", parentName)
	return Window
end

