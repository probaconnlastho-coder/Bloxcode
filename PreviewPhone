	--// DRAGGING (window) -------------------------------------
	local dragging, dragStartMouse, dragStartPos

	local function mouseOverHeaderButton(mouse)
		for _, b in ipairs(headerButtons) do
			local ap, as = b.AbsolutePosition, b.AbsoluteSize
			if mouse.X >= ap.X and mouse.X <= ap.X + as.X
				and mouse.Y >= ap.Y and mouse.Y <= ap.Y + as.Y then
				return true
			end
		end
		return false
	end

	header.InputBegan:Connect(function(input)
		if not Window._dragEnabled then return end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local mouse = UserInputService:GetMouseLocation()
		if mouseOverHeaderButton(mouse) then return end
		dragging = true
		dragStartMouse = mouse
		dragStartPos = Vector2.new(
			root.AbsolutePosition.X + root.AbsoluteSize.X / 2,
			root.AbsolutePosition.Y + root.AbsoluteSize.Y / 2
		)
		tween(rootScale, 0.2, { Scale = 1.02 })
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			if dragging then
				dragging = false
				tween(rootScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
			end
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		if not dragging then return end
		local mouse = UserInputService:GetMouseLocation()
		local target = dragStartPos + (mouse - dragStartMouse)
		local vpNow = (Camera and Camera.ViewportSize) or vp
		local half = root.AbsoluteSize / 2
		local tl = target - half
		tl = Vector2.new(
			math.clamp(tl.X, -root.AbsoluteSize.X + 110, vpNow.X - 110),
			math.clamp(tl.Y, 0, math.max(0, vpNow.Y - 46))
		)
		target = tl + half
		local cur = Vector2.new(root.Position.X.Offset, root.Position.Y.Offset)
		local smooth = cur:Lerp(target, math.min(dt * 17, 1))
		root.Position = UDim2.fromOffset(smooth.X, smooth.Y)
	end)

