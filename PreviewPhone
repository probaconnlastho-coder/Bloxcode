--// Parent resolution -----------------------------------------
local function resolveParent(explicit)
	if explicit then return explicit, "explicit" end
	if type(gethui) == "function" then
		local ok, hui = pcall(gethui)
		if ok and typeof(hui) == "Instance" then return hui, "gethui" end
	end
	local okCG, coreGui = pcall(function() return game:GetService("CoreGui") end)
	if okCG and coreGui then
		if type(syn) == "table" and type(syn.protect_gui) == "function" then
			return coreGui, "CoreGui (protected)"
		end
		local writable = pcall(function()
			local probe = Instance.new("Folder")
			probe.Parent = coreGui
			probe:Destroy()
		end)
		if writable then return coreGui, "CoreGui" end
	end
	local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not pg then pg = LocalPlayer:WaitForChild("PlayerGui", 10) end
	if pg then return pg, "PlayerGui" end
	error("[Auren] No valid parent found")
end

