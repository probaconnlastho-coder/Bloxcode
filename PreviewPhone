local function makeSlidersIcon(parent, color)
	local c = new("Frame", {
		Parent = parent, Size = UDim2.fromOffset(16, 16),
		BackgroundTransparency = 1,
	})
	for i = 1, 3 do
		local y = (i - 1) * 6
		local bar = new("Frame", {
			Parent = c, Position = UDim2.fromOffset(0, y + 2),
			Size = UDim2.new(1, 0, 0, 2),
			BackgroundColor3 = color, BorderSizePixel = 0,
		})
		round(bar, 1)
		local knobX = i == 1 and 3 or (i == 2 and 10 or 6)
		local knob = new("Frame", {
			Parent = c, Position = UDim2.fromOffset(knobX, y),
			Size = UDim2.fromOffset(6, 6),
			BackgroundColor3 = color, BorderSizePixel = 0,
		})
		round(knob, UDim.new(1, 0))
	end
	return c
end

